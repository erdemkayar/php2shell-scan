# Ubuntu 24.04 Apache + mod_php from the distro archive, pinned to one package build.
#   PHPPKG=8.3.6-0maysync1           release pocket, pre-fix (reports 8.3.6)
#   PHPPKG=8.3.6-0ubuntu0.24.04.13   noble-security, CVE-2026-109618/-109619 backported (still reports 8.3.6)
ARG BASE=public.ecr.aws/docker/library/ubuntu:24.04
FROM ${BASE}
ARG PHPPKG
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends apache2 python3 procps \
      php8.3-common=${PHPPKG} php8.3-cli=${PHPPKG} php8.3-opcache=${PHPPKG} php8.3-readline=${PHPPKG} \
      libapache2-mod-php8.3=${PHPPKG} >/dev/null \
 && rm -f /var/www/html/index.html && rm -rf /var/lib/apt/lists/*
EXPOSE 80
CMD ["apache2ctl", "-D", "FOREGROUND"]
